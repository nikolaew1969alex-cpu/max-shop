# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_here
# Пароль для /admin (придумайте длинный)
ADMIN_PASSWORD=change-me
# Бот MAX: токен из настроек бота
MAX_BOT_TOKEN=
# Адрес сервиса на Render, без слэша в конце
PUBLIC_URL=https://max-shop.onrender.com
# Любая случайная строка для проверки вебхука
WEBHOOK_SECRET=
# MAX user_id менеджера (узнать: написать боту /id)
MANAGER_USER_ID=
